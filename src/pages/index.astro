          </div>
        </section>

        <!-- FOOTER -->
        <footer class="pb-16 text-xs text-slate-600">
          <p>
            Inspired by <a href="https://brittanychiang.com" class="text-slate-500 hover:text-teal-300 transition-colors" target="_blank" rel="noopener noreferrer">Brittany Chiang</a>. Built with <a href="https://astro.build" class="text-slate-500 hover:text-teal-300 transition-colors" target="_blank" rel="noopener noreferrer">Astro</a> &amp; <a href="https://tailwindcss.com" class="text-slate-500 hover:text-teal-300 transition-colors" target="_blank" rel="noopener noreferrer">Tailwind</a>. Hosted on GitHub Pages.
          </p>
        </footer>

      </main>
    </div>
  </div>
</Layout>

<script>
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('.nav-link');

  function setActive(id: string) {
    navLinks.forEach(link => {
      const href = link.getAttribute('href');
      const indicator = link.querySelector('.nav-indicator') as HTMLElement;
      const text = link.querySelector('.nav-text') as HTMLElement;
      const isActive = href === `#${id}`;
      indicator?.classList.toggle('w-16', isActive);
      indicator?.classList.toggle('bg-slate-200', isActive);
      indicator?.classList.toggle('w-8', !isActive);
      indicator?.classList.toggle('bg-slate-600', !isActive);
      text?.classList.toggle('text-slate-200', isActive);
      text?.classList.toggle('text-slate-500', !isActive);
    });
  }

  const observer = new IntersectionObserver(
    entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) setActive(entry.target.id);
      });
    },
    { rootMargin: '-40% 0px -55% 0px' }
  );

  sections.forEach(s => observer.observe(s));

  navLinks.forEach(link => {
    link.addEventListener('click', e => {
      e.preventDefault();
      const href = link.getAttribute('href');
      if (href) document.querySelector(href)?.scrollIntoView({ behavior: 'smooth' });
    });
  });
</script>
