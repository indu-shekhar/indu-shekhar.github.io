---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Projects | Indu Shekhar Jha"
  description="All projects by Indu Shekhar Jha: voice banking, AI platforms, RAG systems, and game engines."
>
  <div class="mx-auto min-h-screen w-[80%] py-16 md:py-24">
    <a href="/" class="mb-8 inline-flex items-center gap-2 text-sm font-medium text-teal-400 hover:text-teal-300 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 rotate-180" aria-hidden="true">
        <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
      </svg>
      Indu Shekhar Jha
    </a>

    <h1 class="text-3xl font-bold tracking-tight text-slate-200 sm:text-4xl">All Projects</h1>
    <p class="mt-4 text-slate-400">Things I've built: from AI-powered platforms to systems-level C++ engines.</p>

    <ul class="mt-12 group/list space-y-4">
      {projects.map(project => (
        <li class="group relative rounded-md p-4 transition-all lg:hover:!opacity-100 lg:group-hover/list:opacity-50">
          <div class="absolute inset-0 z-0 rounded-md transition lg:group-hover:bg-slate-800/50 lg:group-hover:shadow-[inset_0_1px_0_0_rgba(148,163,184,0.1)]"></div>
          <div class="z-10 flex flex-col sm:flex-row sm:items-start sm:gap-6">
            {project.data.image && (
              <img
                src={project.data.image}
                alt={project.data.title}
                class="mb-3 h-24 w-40 shrink-0 rounded border border-slate-700 object-cover sm:mb-0"
                loading="lazy"
              />
            )}
            <div class="flex-1">
              <div class="flex items-start justify-between gap-2">
                <h2 class="font-medium text-slate-200">
                  <a href={`/projects/${project.slug}`} class="hover:text-teal-300 transition-colors">
                    <span class="absolute inset-0 rounded-md"></span>
                    {project.data.title}
                  </a>
                </h2>
                <span class="shrink-0 text-xs text-slate-500">{project.data.date.slice(0, 7)}</span>
              </div>
              <p class="mt-1 text-sm text-slate-400">{project.data.description}</p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {project.data.tags.map(tag => (
                  <li>
                    <span class="rounded-full bg-teal-400/10 px-3 py-1 text-xs font-medium text-teal-300">{tag}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</Layout>
